{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PDFkit",
  "version": "0.1.0",
  "identifier": "com.pdfkit.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PDFkit",
        "label": "main",
        "width": 1100,
        "height": 890,
        "minWidth": 860,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self'; connect-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'self';"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Copyright © 2026 Çağdaş Polat (github.com/Chady1Dev) - AGPL-3.0 License",
    "publisher": "Çağdaş Polat",
    "homepage": "https://github.com/Chady1Dev/PDFKit",
    "shortDescription": "Ultra-lightweight local-first PDF toolbox (AGPL-3.0 License)",
    "resources": [
      "scripts/*",
      "scripts/**/*"
    ],
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "name": "PDF Belgesi",
        "description": "Portable Document Format",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "both"
      },
      "wix": {
        "language": "tr-TR"
      }
    }
  }
}
